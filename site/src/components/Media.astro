---
/**
 * One image in a fixed-ratio frame, responsive and lazy by default.
 * Pass `name` to make it a shared element in page transitions
 * (e.g. a ring plate that becomes the case-study hero).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS aspect-ratio of the frame, e.g. "4 / 5". Omit to use the image's own ratio. */
  ratio?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  name?: string;
  widths?: number[];
}

const {
  src,
  alt,
  ratio,
  sizes = '(max-width: 760px) 100vw, 50vw',
  priority = false,
  class: className,
  name,
  widths = [480, 800, 1200, 1600, 2000, 2400],
} = Astro.props;
const usable = widths.filter((w) => w <= src.width);
const widthList = usable.length ? usable : [src.width];
const frame = ratio ? `aspect-ratio: ${ratio}` : `aspect-ratio: ${src.width} / ${src.height}`;
---

{/* transition:name with an undefined value still generates an automatic name, so only set it when asked. */}
{
  name ? (
    <div class:list={['media', className]} style={frame} transition:name={name}>
      <Image
        src={src}
        alt={alt}
        widths={widthList}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        quality={88}
        layout="none"
      />
    </div>
  ) : (
    <div class:list={['media', className]} style={frame}>
      <Image
        src={src}
        alt={alt}
        widths={widthList}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        quality={88}
        layout="none"
      />
    </div>
  )
}
