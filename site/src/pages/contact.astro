---
/**
 * Contact: one screen on ink. The title and the direct lines on the left,
 * the brief on the right; on phones they stack in that order.
 *
 * No global footer (as in the approved wireframe): its address block would
 * repeat the direct lines a scroll below them. The header keeps every route.
 */
import Base from '../layouts/Base.astro';
import Direct from '../components/contact/Direct.astro';
import BriefForm from '../components/contact/BriefForm.astro';
import { studio } from '../data/site';

const description = `Start a project with ${studio.name}. Send a brief, or write to ${studio.email}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact · ${studio.name}`,
  url: new URL('/contact/', Astro.site).href,
  description,
  mainEntity: {
    '@type': 'Organization',
    name: studio.legalName,
    alternateName: studio.name,
    url: studio.url,
    email: studio.email,
    sameAs: [studio.instagram.url],
  },
};
---

<Base title="Contact" description={description} theme="ink" footer={false} jsonLd={jsonLd} headerOverlay>
  <section class="contact wrap" aria-labelledby="contact-title">
    <div class="intro">
      <h1 class="display title" id="contact-title">
        <span class="mask"><span class="word">Start a</span></span>{' '}
        <span class="mask"><span class="word" style="--k:1">project</span></span>
      </h1>
      <div class="direct-in">
        <Direct />
      </div>
    </div>
    <div class="side">
      <BriefForm />
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--g);
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(20px, 3.2vw, 48px));
    /* the page ends here: keep the send button clear of the preview notice */
    padding-bottom: max(clamp(48px, 6vw, 88px), calc(var(--note-h) + 24px));
  }

  .intro {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 56px;
    min-width: 0;
    /* the title is sized to this column (cqi below), not to the viewport */
    container-type: inline-size;
  }

  .side {
    grid-column: 8 / span 5;
    align-self: end;
    min-width: 0;
  }

  /*
   * As large as the page titles elsewhere, but "project" (3.27em wide) must
   * fit its column: the column's width over --fit, capped at --cap. Sized
   * from the column itself (cqi), so a scrollbar gutter cannot push it over;
   * without container units, estimated from the viewport.
   */
  .title {
    --cols: 7;
    --fit: 3.45;
    --cap: var(--t-display);
    --min: 0px;
    font-size: clamp(var(--min), ((100vw - 13 * var(--g)) * var(--cols) / 12 + (var(--cols) - 1) * var(--g)) / var(--fit), var(--cap));
  }

  @supports (width: 1cqi) {
    .title {
      font-size: clamp(var(--min), 100cqi / var(--fit), var(--cap));
    }
  }

  /* each line rises from behind its own baseline */
  .mask {
    display: block;
    overflow: clip;
    padding-block: 0.06em 0.02em;
    margin-block: -0.06em -0.02em;
  }

  /*
   * The mask clips the rise, so a word wider than its column would lose
   * letters (raised letter or word spacing, WCAG 1.4.12). Let it break inside
   * the column instead; at normal spacing it always fits and nothing changes.
   */
  .word {
    display: block;
    overflow-wrap: break-word;
    animation: contact-rise 1.15s var(--ease-out) both;
    animation-delay: calc(60ms + var(--k, 0) * 90ms);
  }

  .direct-in {
    animation: contact-fade 1s var(--ease-out) 0.42s both;
  }

  @keyframes contact-rise {
    from {
      transform: translate3d(0, 104%, 0);
    }
  }

  @keyframes contact-fade {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
  }

  @media (max-width: 1100px) and (min-width: 761px) {
    .intro {
      grid-column: 1 / span 6;
    }

    .title {
      --cols: 6;
    }

    .side {
      grid-column: 7 / span 6;
    }
  }

  /*
   * Tablets held upright (up to 1024 × 1366): side by side, the two columns
   * leave a tall empty band. Stack them as on a phone, title sized by width.
   */
  @media (min-width: 761px) and (max-width: 1100px) and (orientation: portrait) {
    .contact {
      display: block;
      min-height: 0;
    }

    .intro {
      gap: 44px;
    }

    .title {
      font-size: min(var(--t-display), 17vw);
    }

    .side {
      max-width: 720px;
      margin-top: 72px;
      padding-top: 32px;
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 760px) {
    .contact {
      display: block;
      min-height: 0;
      padding-top: calc(var(--header-h) + 12px);
      padding-bottom: max(72px, calc(var(--note-h) + 24px));
    }

    .intro {
      gap: 36px;
    }

    /* the phone size every page title shares ("project" fits it down to 320px) */
    .title {
      font-size: var(--t-display);
    }

    .side {
      margin-top: 64px;
      padding-top: 28px;
      border-top: 1px solid var(--rule);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word,
    .direct-in {
      animation: none;
    }
  }
</style>
